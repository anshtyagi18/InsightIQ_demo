# Environment variables for InsightIQ Backend

# Google Cloud configuration
GOOGLE_CLOUD_PROJECT=insightiq
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# OpenAI API Key (for LangChain)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API Key (for LangChain Google GenAI)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Database configuration (if needed)
DATABASE_URL=postgresql://neondb_owner:npg_X7oxFtQ3VzGU@ep-noisy-cell-a8dj7y1d-pooler.eastus2.azure.neon.tech/neondb?sslmode=require

# Redis configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Development settings
DEBUG=true
LOG_LEVEL=INFO

# CORS settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# InsightIQ Backend Configuration

# Required: OpenRouter API Configuration (Primary AI Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
USE_LITELLM=true

# Optional: OpenRouter Site Information (Recommended for better rate limits)
OR_SITE_URL=https://insightiq.app
OR_APP_NAME=InsightIQ

# Optional: Google Cloud Configuration (Fallback)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: A4F API Configuration (Additional Provider)
A4F_API_KEY=your_a4f_api_key_here

# Optional: Together AI Configuration (Additional Provider with Free Models)
TOGETHER_API_KEY=your_together_api_key_here

# Storage Configuration
GOOGLE_CLOUD_STORAGE_BUCKET=insightiq-storage

# Server Configuration
PORT=8000
ENVIRONMENT=development

# AI Model Configuration
# Main model: DeepSeek R1 (free tier via OpenRouter)
MAIN_MODEL=openrouter/deepseek/deepseek-r1-0528:free
# Fallback models (comma-separated, all via OpenRouter)
FALLBACK_MODELS=openrouter/google/gemma-3n-e4b-it:free,openrouter/anthropic/claude-sonnet-4

# Analytics Features
ENABLE_AI_FEATURES=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_A2A_INTEGRATION=true
ENABLE_ENHANCED_ANALYTICS=true

# Performance Configuration
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=60
MAX_TOKENS_DEFAULT=4096
ENABLE_RESPONSE_CACHE=true
CACHE_TTL_HOURS=1

# Logging
ENABLE_MODEL_STATS=true 