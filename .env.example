# ==============================================================================
# Insightia / InsightIQ Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FREE-TIER LLM API KEYS (Configure at least ONE for AI Copilot, or leave empty for offline deterministic sandbox)
# ------------------------------------------------------------------------------

# Option A (Recommended): Google Gemini API (Generous free tier: gemini-2.0-flash / gemini-1.5-flash)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: Groq Cloud API (High-speed free tier: llama-3.3-70b-versatile / mixtral-8x7b)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option C: OpenRouter Free Tier (meta-llama/llama-3.3-70b-instruct:free)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER & DATABASE SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
DATABASE_URL=sqlite:///./insightiq.db
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. FRONTEND VITE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
