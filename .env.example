# ==============================================================================
# Insightia / InsightIQ Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FREE-TIER LLM API KEYS (Configure at least ONE for AI Copilot, or leave empty for offline deterministic sandbox)
# ------------------------------------------------------------------------------

# Option 0 (Recommended): FreeLLMAPI Unified LLM Router (Local Desktop App or Docker Gateway)
# Free router: https://freellmapi.co or https://github.com/tashfeenahmed/freellmapi
# Desktop App defaults to port 31415 (http://127.0.0.1:31415/v1); Docker defaults to port 3001 (http://localhost:3001/v1)
FREELLMAPI_KEY=freellmapi-your-unified-key-here
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=llama-3.3-70b

# Option A: Google Gemini API (Generous free tier: gemini-2.0-flash / gemini-1.5-flash)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: Groq Cloud API (High-speed free tier: llama-3.3-70b-versatile / mixtral-8x7b)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option C: OpenRouter Free Tier (meta-llama/llama-3.3-70b-instruct:free)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER & DATABASE SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
DATABASE_URL=sqlite:///./insightiq.db
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. FRONTEND VITE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
